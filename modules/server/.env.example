# Server runtime configuration (loaded via `import 'dotenv/config'` in src/index.ts)

NODE_ENV=development

# HTTP
PORT=8080

# MongoDB connection string (credentials match the root .env / docker-compose)
MONGODB_URI=mongodb://admin:secret@localhost:27017/kronos?authSource=admin

# JWT signing secrets — REQUIRED in production (startup throws if unset when NODE_ENV=production)
JWT_SECRET=your_super_secret_key
JWT_REFRESH_SECRET=your_super_refresh_secret_key
