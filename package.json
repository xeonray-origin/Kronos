{
  "name": "kronos",
  "version": "0.0.1",
  "description": "A mern stack productivity app.",
  "main": "index.js",
  "scripts": {
    "build:client": "pnpm --filter @kronos/client build",
    "build:server": "pnpm --filter @kronos/client build",
    "build:clean": "tsc --build --clean",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @kronos/server dev",
    "dev:client": "pnpm --filter @kronos/client dev",
    "prepare": "node .husky/install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/xeonray-origin/Kronos.git"
  },
  "keywords": [
    "MERN",
    "ReactJS",
    "NodeJS",
    "ExpressJS",
    "TodoApp"
  ],
  "author": "xeonray-origin",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/xeonray-origin/Kronos/issues"
  },
  "homepage": "https://github.com/xeonray-origin/Kronos#readme",
  "engines": {
    "node": "^22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
